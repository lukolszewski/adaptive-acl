{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@earendil-works/pi-tui": ["./node_modules/@earendil-works/pi-tui"]
    }
  },
  "include": ["*.ts", "tools/*.ts"],
  "exclude": ["node_modules", "eval", "spike"]
}
