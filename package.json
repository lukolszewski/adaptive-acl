{
  "name": "@lukolszewski/adaptive-acl",
  "version": "2.8.0",
  "type": "module",
  "description": "Named permission modes for the pi coding agent — user-defined ask/allow/deny modes with per-mode model forwarding, a deterministic bash gate, outside-cwd write tracking and a cryptographic rule ledger.",
  "keywords": [
    "pi-package"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukolszewski/adaptive-acl.git"
  },
  "bugs": {
    "url": "https://github.com/lukolszewski/adaptive-acl/issues"
  },
  "homepage": "https://github.com/lukolszewski/adaptive-acl#readme",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:dry": "npm pack --dry-run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "*.ts",
    "!*.test.ts",
    "!vitest.config.ts",
    "!vitest.setup.ts",
    "classifier-prompts/**",
    "wasm/**",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "web-tree-sitter": "0.27.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^1.6.0"
  }
}
